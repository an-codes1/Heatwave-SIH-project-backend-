# Core
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/heatwave_db
APP_NAME=Bhubaneswar Heat Health Early Warning API
DEBUG=true

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# DB connection pool
# DB_POOL_SIZE=0 selects NullPool (one connection per session) - used by tests
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Notifications
NOTIFICATION_DRY_RUN=true

# Optional: real SMS delivery via Twilio (leave unset for dry-run only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
ALERT_RECIPIENT_PHONE=

# Admin API key (required for state-changing alert endpoints)
# Clients must send:  X-Admin-Key: <value>
ADMIN_API_KEY=replace_with_secure_value